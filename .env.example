# Copia este archivo a .env.local y completa los valores.
# .env.local está ignorado por git: nunca subas secretos al repositorio.
#
# Desarrollo y producción usan el MISMO proyecto de Supabase.
# .env.local y Vercel (entorno Production) llevan la misma URL, anon key y service role.
# La lista de qué pegar en cada sitio está en el README, sección Producción.

# Supabase: Project Settings > API. Los mismos valores van en Vercel Production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Correo público de contacto. Sale en /privacidad, /terminos y en
# /.well-known/security.txt. No es un secreto: el prefijo NEXT_PUBLIC_ lo
# deja en el navegador. La app no arranca si falta o no es un correo.
NEXT_PUBLIC_CONTACT_EMAIL=

# Solo servidor (.env.local y Vercel Production). Nunca en el cliente ni con NEXT_PUBLIC_.
# Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Secreto de los cron (/api/cron/rates, /api/cron/occurrences, /api/cron/purge-deleted).
# No sale de Supabase. Genera uno y pégalo en .env.local y en Vercel Production:
#   openssl rand -hex 32
# En Vercel, la variable tiene que llamarse CRON_SECRET. Vercel la manda como
# Authorization: Bearer <CRON_SECRET> solo en los cron del deploy de producción.
CRON_SECRET=

# Bot de Telegram (fase T1). Opcional: si falta el token o el secreto,
# Ajustes oculta Conexiones y /api/telegram/webhook responde 404.
# El token lo da @BotFather. El secreto se genera así y se pega igual en
# .env.local y en Vercel Production (nunca con prefijo NEXT_PUBLIC_):
#   openssl rand -hex 32
# pnpm telegram:webhook lo manda como secret_token al registrar el webhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Solo para los tests SQL (pnpm test:rls, pnpm test:db:fresh). Postgres LOCAL,
# nunca Supabase: el script exige localhost y una base que termine en _test,
# y la borra en cada corrida. Ver README, "Pruebas de base de datos".
TEST_DATABASE_URL=postgresql://localhost:5432/ember_cash_test
