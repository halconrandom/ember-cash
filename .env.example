# Copia este archivo a .env.local y completa los valores.
# .env.local está ignorado por git: nunca subas secretos al repositorio.

# Supabase: Project Settings > API (o la salida de `pnpm exec supabase start` en local).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor. Nunca la uses en código de cliente ni la prefijes con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Secreto compartido para autenticar los cron jobs. Genera uno con:
#   openssl rand -hex 32
CRON_SECRET=
