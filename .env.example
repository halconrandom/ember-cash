# Copia este archivo a .env.local y completa los valores.
# .env.local está ignorado por git: nunca subas secretos al repositorio.
#
# Local y Preview usan el proyecto de Supabase de DESARROLLO.
# Producción (Vercel, entorno Production) usa OTRO proyecto. No mezcles las claves.
# La lista de qué pegar en cada sitio está en el README, sección Producción.

# Supabase de este entorno: Project Settings > API.
# En Vercel Production: la URL y la anon key del proyecto de producción.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor (Vercel Production y .env.local). Nunca en el cliente ni con NEXT_PUBLIC_.
# Project Settings > API > service_role. La de producción no es la de desarrollo.
SUPABASE_SERVICE_ROLE_KEY=

# Secreto de los cron (/api/cron/rates, /api/cron/occurrences, /api/cron/purge-deleted).
# No sale de Supabase. Genera uno distinto para producción:
#   openssl rand -hex 32
# En Vercel, la variable tiene que llamarse CRON_SECRET. Vercel la manda como
# Authorization: Bearer <CRON_SECRET> solo en los cron del deploy de producción.
CRON_SECRET=
